{
  "name": "text-to-trx",
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a spoken-style English sentence into structured money transactions, fully offline and rule-based.",
  "license": "MIT",
  "author": "Adli Arindra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adli-arindra/text-to-trx.git"
  },
  "keywords": [
    "nlp",
    "parser",
    "finance",
    "react-native",
    "speech-to-text"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
